# Copie este arquivo para .env e preencha só o que for usar. Tudo é opcional.

# Idiomas dos vídeos oferecidos no app (separados por vírgula).
CVM_VIDEO_LANGUAGES=pt-BR,en-US

# Fuso do estúdio, mostrado ao lado do fuso do público no calendário (ex.: America/Sao_Paulo).
# Vazio = o fuso deste computador.
CVM_DEFAULT_TZ=

# Chaves gratuitas. Sem elas, o app usa só as fontes que não pedem cadastro.
# YouTube Data API v3 (tendências e métricas): Google Cloud > APIs > YouTube Data API v3 > chave de API
CVM_YOUTUBE_API_KEY=
# Vídeos de banco: https://www.pexels.com/api/ e https://pixabay.com/api/docs/
CVM_PEXELS_API_KEY=
CVM_PIXABAY_API_KEY=

# Envio e métricas do YouTube: cliente OAuth do tipo "App para computador" (ou data/secrets/youtube_client_secret.json).
CVM_GOOGLE_CLIENT_ID=
CVM_GOOGLE_CLIENT_SECRET=
# Projetos do Google não auditados só podem enviar vídeos privados.
CVM_YOUTUBE_PRIVACY=private

# Opcional e pago (só se você já tiver conta): voz, música e efeitos pela ElevenLabs.
# Sem chave, o app usa as vozes locais.
CVM_ELEVENLABS_API_KEY=

# true = o worker chama o Claude sozinho para roteiro e SEO; false = botão "Rodar no Claude".
CVM_CLAUDE_AUTO_RUN=true

# Optional: lets yt-dlp use your browser login when YouTube refuses a link (age-restricted video).
# A browser name (chrome, safari, firefox, "chrome:Profile 2") or the path to a cookies.txt file.
CVM_YTDLP_COOKIES=
